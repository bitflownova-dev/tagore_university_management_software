# Application
NODE_ENV=development
PORT=3000
APP_NAME=Tagore University Management System

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=yourpassword
DATABASE_NAME=tagore_university

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=tagore-university
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tagore-university.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@tagore.edu.in
SMTP_PASSWORD=yourpassword
SMTP_FROM=Tagore University <notifications@tagore.edu.in>

# AWS S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=tagore-university-files

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend URLs (CORS)
FRONTEND_WEB_URL=http://localhost:3001
FRONTEND_MOBILE_URL=exp://192.168.1.100:19000

# Logging
LOG_LEVEL=debug
